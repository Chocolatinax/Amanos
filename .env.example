# URL del backend NestJS. Si está vacío, el front usa seed local + localStorage (modo demo).
NEXT_PUBLIC_API_URL=
# Umbral para marcar una seña como dominada (0-100)
NEXT_PUBLIC_MASTER_THRESHOLD=90
# Google Sign-In (opcional; mismo client id que GOOGLE_CLIENT_ID de la API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
