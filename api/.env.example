PORT=4000
NODE_ENV=development
APP_TIMEZONE=America/El_Salvador
JWT_SECRET=cambiame-por-algo-largo-y-aleatorio
# Orígenes permitidos del front, separados por coma
CORS_ORIGINS=http://localhost:3000
# Login de demo sin contraseña (por defecto activo solo fuera de producción)
ALLOW_DEMO_AUTH=true
# Google Sign-In (mismo client id que NEXT_PUBLIC_GOOGLE_CLIENT_ID del front)
GOOGLE_CLIENT_ID=
# Base de datos: vacío = archivo local amanos.sqlite (sql.js). Con DATABASE_URL usa Postgres.
SQLITE_PATH=amanos.sqlite
# Supabase: Project Settings > Database > Connection string (Session pooler, puerto 5432 o Direct).
# Formato: postgresql://postgres.<ref>:<PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Las tablas ya existen (supabase/migrations). Con DATABASE_URL, TypeORM NO crea tablas (DB_SYNC=false).
DATABASE_URL=
DB_SYNC=false
MASTER_THRESHOLD=90
